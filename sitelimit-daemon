#!/bin/bash

CONF=/etc/sitelimit.conf
F=/var/lib/sitelimit
TICK=10

if [ ! -r "$CONF" ]; then
  echo "sitelimit-daemon: cannot read $CONF" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$CONF"

if [ -z "${USER_NAME:-}" ] || [ -z "${LIMIT:-}" ] || [ -z "${BROWSERS:-}" ]; then
  echo "sitelimit-daemon: USER_NAME, LIMIT and BROWSERS must be set in $CONF" >&2
  exit 1
fi

if ! declare -p RE >/dev/null 2>&1 || ! declare -p DOMS >/dev/null 2>&1; then
  echo "sitelimit-daemon: RE and DOMS must be declared in $CONF" >&2
  exit 1
fi

export DISPLAY=:0
export XAUTHORITY="/home/$USER_NAME/.Xauthority"

mkdir -p "$F"

flush_dns() {
  resolvectl flush-caches 2>/dev/null || nscd -i hosts 2>/dev/null || true
}

while true; do
  today=$(date +%F)
  if [ "$(cat "$F/day" 2>/dev/null)" != "$today" ]; then
    printf '%s\n' "$today" > "$F/day"
    for site in "${!RE[@]}"; do
      printf '0\n' > "$F/$site"
    done
    sed -i '/#sitelimit/d' /etc/hosts
    flush_dns
  fi

  title=$(timeout 3 xdotool getactivewindow getwindowname 2>/dev/null)
  class=$(timeout 3 xdotool getactivewindow getwindowclassname 2>/dev/null)

  is_browser=0
  class_lc=${class,,}
  browsers_lc=${BROWSERS,,}
  if [[ "$class_lc" =~ $browsers_lc ]]; then
    is_browser=1
  fi

  for site in "${!RE[@]}"; do
    used=$(cat "$F/$site" 2>/dev/null || echo 0)
    used=${used//[^0-9]/}
    used=${used:-0}
    if ((is_browser)) && [[ "$title" =~ ${RE[$site]} ]] && ((10#$used < LIMIT)); then
      used=$((10#$used + TICK))
      printf '%s\n' "$used" > "$F/$site"
    fi
    if ((10#$used >= LIMIT)) && ! grep -q "#sitelimit-$site" /etc/hosts; then
      read -ra domains <<< "${DOMS[$site]}"
      for d in "${domains[@]}"; do
        printf '0.0.0.0 %s #sitelimit-%s\n' "$d" "$site" >> /etc/hosts
      done
      flush_dns
      timeout 3 wmctrl -l \
        | grep -E "${RE[$site]}" \
        | cut -d' ' -f1 \
        | xargs -r -I{} timeout 3 wmctrl -ic {}
    fi
  done

  sleep "$TICK"
done
